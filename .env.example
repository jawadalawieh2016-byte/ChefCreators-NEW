# Public Firebase client configuration. These values are identifiers, not server secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

PUBLIC_SITE_URL=https://example.com
DOMAIN=example.com
PRIVACY_EMAIL=privacy@example.com
SUPPORT_EMAIL=support@example.com

# Public Stripe price identifier used by the web checkout button.
STRIPE_PRICE_ID=

# Server-only secrets. Configure these in Firebase Functions/Secret Manager, not as VITE_*.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Render API service.
DATABASE_URL=
ADMIN_PIN=kafta
CORS_ORIGIN=https://your-static-site.onrender.com
